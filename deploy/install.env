# =============================================================================
# install.env — конфигурация развертывания
# Версия: v1.3.0
# Дата:   2026-07-23
# -----------------------------------------------------------------------------
# Назначение:
#   Единственный конфигурационный файл, который меняется от установки к установке.
#   Описывает:
#     • какую ОС восстанавливаем (OS),
#     • из какого каталога брать бэкап (backup_dir),
#     • правила отбора и фильтрации физических дисков,
#     • схему разметки дисков (LVM/FS),
#     • параметры монтирования отдельных дисков (/var/log и др.),
#     • базовые сетевые и служебные параметры.
#
# ВАЖНО:
#   - ФИЗИЧЕСКОЕ место хранения (сервер, учётка, пароль, базовый путь) зашито
#     в auto_install.sh и едино для install.env, бандла и каталогов бэкапов.
#   - Здесь мы задаём, ЧТО ставим (OS) и КАК (разметка/схема LVM/фильтры), а также
#     КУДА идти за конкретным бэкапом внутри общего хранилища (backup_dir).
#   - Переменные backup_ip и backup_passwd выставляются auto_install.sh
#     автоматически и здесь НЕ задаются.
# =============================================================================

# ====================== Базовый выбор ОС и бэкапа ============================

# Какая ОС восстанавливается (должен существовать os/${OS}/80_chroot.sh).
# Примеры:
#   alt
#   redos
OS=redos

# Где искать конкретный бэкап (ОТНОСИТЕЛЬНО общего хранилища на сервере).
# Значение должно совпадать с реальным путём к root.tgz и fstab на сервере.
#backup_dir="/backup/alt/c10f2"
backup_dir="/backup/redos/redos8c"

# ====================== Настройки фильтрации дисков ==========================

# Выбор типа диска для ОС: auto (все), nvme (только NVMe), sd (только SATA/SAS/SCSI)
TARGET_DISK_TYPE="auto"

# Исключить тип дисков из поиска: none (не исключать), nvme (игнорировать NVMe), sd (игнорировать SATA/SAS/SCSI)
EXCLUDE_DISK_TYPE="none"

# ====================== Разметка / LVM =======================================

# Выбор системных дисков по диапазону размеров (GiB).
# В этот диапазон должны попадать диски, на которых будет размещена система.
min_size_gb=150        # GiB, включительно (нижняя граница для системных дисков)
max_size_gb=350        # GiB, включительно (верхняя граница для системных дисков)

# Размеры разделов (MiB) — используются при первичной разметке.
esp_mb=600             # EFI System Partition (FAT32, будет смонтирована в /boot/efi)
boot_mb=1024           # /boot (отдельный раздел, НЕ в LVM)
swap_mb=0           # swap (внутри LVM VG)
vg_name="redos"        # имя Volume Group (должно совпадать с ожиданиями chroot-скриптов)

# ====================== LVM Logical Volumes Sizes (MiB) ======================
# --- Настройка схемы LVM-разделов --------------------------------------------
#
# /var:
#   Если var_mb > 0:
#       • Активируется НОВАЯ СХЕМА.
#       • LV для /var создаётся и получает 100%FREE внутри VG.
#       • LV для / (root) получает фиксированный размер root_mb.
#
#   Если var_mb = 0:
#       • Активируется СТАРАЯ СХЕМА.
#       • LV для /var НЕ создаётся.
#       • LV для / (root) получает 100%FREE внутри VG.
#
# Обратите внимание:
#   - Само числовое значение var_mb используется как флаг (>0 / =0),
#     а не как реальный размер LV для /var.
var_mb=1               # 0 — старая схема (всё в /); >0 — новая схема (/ + /var)

# Размеры LV, используемые в обеих схемах. 0 — LV не создаётся.
root_mb=20480           # Размер LV для / (используется только в новой схеме, когда var_mb > 0)
tmp_mb=6144               # Размер LV для /tmp
vartmp_mb=5120            # Размер LV для /var/tmp
home_mb=20480              # Размер LV для /home
varlog_lv_mb=20480         # Размер LV для /var/log (игнорируется, если use_varlog_disk=true)
varlogaudit_lv_mb=5120    # Размер LV для /var/log/audit (0 — не создавать отдельный LV)

# ====================== Типы файловых систем (FS Types) ======================
# Доступные типы: xfs, ext4.
# ВАЖНО: /boot всегда ext4, ESP всегда vfat, SWAP всегда swap.
root_fs=xfs           # ФС для / (root)
var_fs=xfs            # ФС для /var
tmp_fs=xfs            # ФС для /tmp
vartmp_fs=xfs         # ФС для /var/tmp
home_fs=xfs           # ФС для /home
varlog_lv_fs=xfs      # ФС для /var/log LV (если не выносится на отдельный диск)
varlogaudit_lv_fs=xfs # ФС для /var/log/audit LV

# ====================== XFS COMPATIBILITY ====================================
# Если используются старые ядра (5.x), оставьте флаги '-m crc=0,finobt=0'
# для избежания ошибки 'bad superblock' при монтировании XFS.
# Для новых ядер используйте пустую строку (современный формат по умолчанию).
#xfs_compat_flags="-m crc=0,finobt=0"
xfs_compat_flags=""

# ====================== Отдельный /var/log (по желанию) ======================
# Если use_varlog_disk=true, ищем ОТДЕЛЬНЫЙ диск по диапазону размеров и
# используем его как готовую ФС /var/log (по метке/размеру).
use_varlog_disk=false
varlog_min_gb=15
varlog_max_gb=50
varlog_label="VARLOG"   # ожидаемая метка ФС (например, xfs -L VARLOG)

# ====================== Логи =================================================
# Пути для ранних логов (LiveCD) и логов внутри целевой системы.
early_log="/tmp/deploy.log"                # лог на LiveCD (ведёт auto_install)
target_log="/mnt/target/root/deploy.log"   # лог внутри целевой системы (ведут шаги)

# ====================== Метаданные ===========================================
# Базовое имя хоста, которое может использоваться на этапе персонализации.
meta_hostname="deploy"

# ====================== NETWORK CONFIGURATION (for Ansible/SSH) ==============
# Эти параметры экспортируются в chroot и используются для настройки
# базовой сети/Ansible-доступа.
#
# Базовый адрес сети (например, 192.168.1.0/24).
net_cidr="192.168.77.0/24"
# Имя интерфейса для настройки (например, eth0, ens33, enp1s0).
# Обязательно проверьте фактическое имя интерфейса на ваших серверах!
net_iface="eno3"

# -----------------------------------------------------------------------------
# Предложения по улучшению (план модернизации):
#
# 1) Поддержка выноса дополнительных каталогов на отдельный диск:
#    Расширить логику `use_varlog_disk` до универсального массива/списка
#    точек монтирования (например, /var/log, /var/lib/docker и т.д.).
#
# 2) Селектор системного диска при совпадении размеров:
#    Добавить автоопределение по типу (SSD vs NVMe), если системный диск
#    и диск под логи/данные имеют одинаковую емкость (GiB).
#
# 3) Контроль целостности бэкапа:
#    Ввести checksum-файл (backup_dir/SHA256SUMS) и опцию verify_checksums=true/false
#    для проверки архива перед его распаковкой.
# -----------------------------------------------------------------------------
